<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TS4Tools.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="420"
        x:Class="TS4Tools.UI.Views.Dialogs.ResourceDetailsWindow"
        x:DataType="vm:ResourceDetailsViewModel"
        Title="Resource Details"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <!-- Source: legacy_references/Sims4Tools/s4pe/Import/ResourceDetails.designer.cs lines 59-384 -->

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button Content="OK" Padding="24,8" IsDefault="True" Command="{Binding OkCommand}" />
            <Button Content="Cancel" Padding="24,8" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>

        <StackPanel Spacing="10">
            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="Type" VerticalAlignment="Center" />
                <AutoCompleteBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding KnownTypes}"
                                 Text="{Binding TypeText}" FilterMode="ContainsOrdinal" MinimumPrefixLength="1" />

                <TextBlock Grid.Row="1" Text="Group" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GroupText}" />

                <TextBlock Grid.Row="2" Text="Instance" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InstanceText}" />

                <TextBlock Grid.Row="3" Text="Filename" VerticalAlignment="Center" IsVisible="{Binding ShowFilename}" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="FilenameTextBox" Text="{Binding Filename}"
                         IsVisible="{Binding ShowFilename}" DragDrop.AllowDrop="True" />
            </Grid>

            <!-- Source: ResourceDetails.designer.cs lines 241-310 (Name row with FNV64, CLIP IID, FNV32) -->
            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto" RowSpacing="8" IsEnabled="{Binding NameEnabled}">
                <TextBlock Text="Name" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding ResourceName}" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="FNV_64" Command="{Binding Fnv64Command}" Padding="12,4" />
                    <Button Content="CLIP _IID" Command="{Binding ClipIidCommand}" Padding="12,4" />
                    <Button Content="FNV_32" Command="{Binding Fnv32Command}" Padding="12,4" />
                </StackPanel>
            </Grid>

            <!-- Source: ResourceDetails.designer.cs lines 312-366 (Copy RK, Paste RK, Set High Bit) -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CopyKeyButton" Content="_Copy RK" Padding="12,4" />
                <Button x:Name="PasteKeyButton" Content="_Paste RK" Padding="12,4" />
                <Button Content="Set _High Bit" Command="{Binding HighBitCommand}" Padding="12,4" />
            </StackPanel>

            <!-- Source: legacy_references/Sims4Tools/s4pe/Import/ImportSettings.Designer.cs lines 56-135 -->
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                <WrapPanel DataContext="{Binding Settings}" x:DataType="vm:ImportSettingsViewModel" ItemSpacing="16" LineSpacing="8">
                    <StackPanel>
                        <RadioButton GroupName="Duplicates" Content="Replace duplicates" IsChecked="{Binding Replace}" IsEnabled="{Binding ReplaceEnabled}" />
                        <RadioButton GroupName="Duplicates" Content="Reject duplicates" IsChecked="{Binding Reject}" IsEnabled="{Binding ReplaceEnabled}" />
                    </StackPanel>
                    <CheckBox Content="Compress" IsChecked="{Binding Compress}" IsEnabled="{Binding CompressEnabled}" />
                    <CheckBox Content="Use resource name" IsChecked="{Binding UseName}" IsEnabled="{Binding UseNameEnabled}" />
                    <CheckBox Content="Rename if present" IsChecked="{Binding AllowRename}" IsEnabled="{Binding CanAllowRename}" />
                </WrapPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
